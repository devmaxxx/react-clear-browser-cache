{
  "name": "react-clear-browser-cache",
  "version": "0.3.0",
  "author": "arenuzzz",
  "description": "Library for clearing browser cache after react app updates",
  "license": "MIT",
  "repository": "arenuzzz/react-clear-browser-cache",
  "type": "commonjs",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "generate-build-meta": "./bin/cli.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "engines": {
    "node": ">=18.3"
  },
  "keywords": [
    "cache",
    "browser cache",
    "clear cache",
    "refresh cache",
    "react"
  ],
  "packageManager": "pnpm@10.23.0",
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p example && tsc --noEmit -p e2e",
    "lint": "eslint . && prettier --check . && pnpm run lint:html",
    "lint:html": "html-validate example/index.html",
    "test": "pnpm run lint && pnpm run build && pnpm run typecheck && pnpm run test:unit && playwright test",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm run build && playwright test",
    "example:dev": "pnpm --filter react-clear-browser-cache-example dev",
    "example:build": "pnpm --filter react-clear-browser-cache-example build",
    "demo:dev": "VITE_DEMO=1 pnpm run example:dev",
    "demo:build": "VITE_DEMO=1 BASE_PATH=/react-clear-browser-cache/ pnpm --filter react-clear-browser-cache-example exec vite build --outDir dist-demo",
    "demo:preview": "BASE_PATH=/react-clear-browser-cache/ pnpm --filter react-clear-browser-cache-example preview --outDir dist-demo"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "html-validate": "^11.16.2",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsdown": "^0.23.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
